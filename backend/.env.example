# Copy to .env and fill in. Never commit .env.

# From @BotFather (/newbot). Each dev should use their OWN bot token —
# only one process can long-poll a token at a time.
TELEGRAM_BOT_TOKEN=
# Bot username without @, used to build deep links like t.me/<username>?start=GARCIA1
TELEGRAM_BOT_USERNAME=

# Chat id of the nurse/care-team Telegram group (negative number, e.g. -1001234567890)
NURSE_CHAT_ID=
# Fallback for nurse alerts when Telegram is down or no group is set up: a phone that gets SMS/WhatsApp
# (needs the Twilio section below). Without NURSE_CHAT_ID or NURSE_PHONE, alerts only reach the dashboard.
NURSE_PHONE=

# ---- AI (all optional; app works on rules alone) ----
# Chain: Claude -> Gemini -> Ollama -> LM Studio -> none. auto picks the first one available.
# Set to claude | gemini | ollama | lmstudio to pin one, or none to disable.
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# Gemini (second in the chain). Key from https://aistudio.google.com/apikey.
# Default model is the stable alias gemini-flash-latest (fixed versions get retired);
# gemini-3.8-flash is faster (~3s). NOTE: an existing system-wide GEMINI_API_KEY wins over .env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Ollama: `ollama pull qwen2.5:7b-instruct` then just run it. Model auto-picked if blank.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=
# LM Studio: Developer tab -> Start Server, load a model. Model auto-picked if blank.
LMSTUDIO_URL=http://localhost:1234
LMSTUDIO_MODEL=

# Optional — free tier, for transcribing Telegram voice notes (stretch goal)
GROQ_API_KEY=

# ---- SMS & WhatsApp via Twilio (Krish lane, optional; see docs/TELEGRAM_SETUP.md §8) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Your Twilio number, e.g. +14045550100
TWILIO_SMS_FROM=
# Sandbox: whatsapp:+14155238886
TWILIO_WHATSAPP_FROM=
# Public base URL Twilio calls (ngrok), used to verify webhook signatures
PUBLIC_URL=
# Telegram webhook mode (production; see docs/TELEGRAM_SETUP.md §9). Unset = long polling (the default).
# Public HTTPS base URL; the backend registers <url>/webhooks/telegram and stops polling.
TELEGRAM_WEBHOOK_URL=
# Random string Telegram sends back on every call (A-Z a-z 0-9 _ -). Required in production.
TELEGRAM_WEBHOOK_SECRET=
# Withings client secret: POST /webhooks/withings then needs X-Withings-Signature (hex HMAC-SHA256 of the
# body). Unset = unsigned deliveries accepted in dev, every delivery refused in production.
WITHINGS_CLIENT_SECRET=

PORT=3001

# ---- Access control (core) ----
# Shared token for the dashboard API + live feed. Unset = open (fine on localhost only).
API_TOKEN=
# Browsers allowed to call the API cross-origin, comma-separated. Unset = this machine's own pages only (localhost / private LAN) in dev, closed in production.
CORS_ORIGIN=
# With no API_TOKEN the API only answers pages and hosts on this machine (localhost / private LAN).
# Reaching it through a tunnel or a public name? List the host here (comma-separated), or set API_TOKEN.
ALLOWED_HOSTS=
# Destructive demo controls (reset, clock advance, cohort regenerate): on in dev, off when
# NODE_ENV=production unless DEMO_MODE=1. DEMO_MODE=0 turns them off anywhere.
DEMO_MODE=
# Key home devices send as x-device-key on POST /api/devices/readings (opens that endpoint only). Unset = no device key needed.
DEVICE_KEY=

# ---- Risk LLM reviewer (Maharshi, backend/src/riskllm) ----
# Post-check-in reviewer on the shared chain above; may raise GREEN -> YELLOW, never lowers, never RED.
# off disables it (rules alone decide).
RISK_LLM=on
# Per-call model preference (takes effect once the chain accepts a model option; see REQUESTS.md).
RISK_MODEL=
# Give up after this long; local CPU models need 1-2 min for a full review.
RISK_TIMEOUT_MS=180000
# EHR import (M5): any FHIR R4 server; defaults to the public HAPI sandbox. Read-only.
# With NODE_ENV=production the public sandbox is refused (search / import answer 503) unless
# DEMO_MODE=1: a search there would send a real patient's name to a server anyone can read.
FHIR_BASE_URL=https://hapi.fhir.org/baseR4
FHIR_TIMEOUT_MS=15000
